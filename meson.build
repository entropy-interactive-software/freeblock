project('freeblock', 'c', 'cpp', default_options: ['cpp_std=c++20'])

rdm4001_proj = subproject('rdm4001')
rdm4001_dep = rdm4001_proj.get_variable('rdm4001_dep')

cc = meson.get_compiler('c')
m_dep = cc.find_library('m', required : false)

lua = shared_library('lua',
                     'lua/lapi.c',
                     'lua/lapi.h',
                     'lua/lauxlib.c',
                     'lua/lauxlib.h',
                     'lua/lbaselib.c',
                     'lua/lcode.c',
                     'lua/lcode.h',
                     'lua/lcorolib.c',
                     'lua/lctype.c',
                     'lua/lctype.h',
                     'lua/ldblib.c',
                     'lua/ldebug.c',
                     'lua/ldebug.h',
                     'lua/ldo.c',
                     'lua/ldo.h',
                     'lua/ldump.c',
                     'lua/lfunc.c',
                     'lua/lfunc.h',
                     'lua/lgc.c',
                     'lua/lgc.h',
                     'lua/linit.c',
                     'lua/liolib.c',
                     'lua/ljumptab.h',
                     'lua/llex.c',
                     'lua/llex.h',
                     'lua/llimits.h',
                     'lua/lmathlib.c',
                     'lua/lmem.c',
                     'lua/lmem.h',
                     'lua/loadlib.c',
                     'lua/lobject.c',
                     'lua/lobject.h',
                     'lua/lopcodes.c',
                     'lua/lopcodes.h',
                     'lua/lopnames.h',
                     'lua/loslib.c',
                     'lua/lparser.c',
                     'lua/lparser.h',
                     'lua/lprefix.h',
                     'lua/lstate.c',
                     'lua/lstate.h',
                     'lua/lstring.c',
                     'lua/lstring.h',
                     'lua/lstrlib.c',
                     'lua/ltable.c',
                     'lua/ltable.h',
                     'lua/ltablib.c',
                     'lua/ltests.c',
                     'lua/ltests.h',
                     'lua/ltm.c',
                     'lua/ltm.h',
                     'lua/luaconf.h',
                     'lua/lua.h',
                     'lua/lundump.c',
                     'lua/lundump.h',
                     'lua/lutf8lib.c',
                     'lua/lvm.c',
                     'lua/lvm.h',
                     'lua/lzio.c',
                     'lua/lzio.h',
                     dependencies: m_dep
                    )

base = static_library('base',
                      'block.cpp',
                      'block.hpp',
                      'datamodel.cpp',
                      'datamodel.hpp',
                      'datamodel_load_legacy.cpp', # rbxl loading
                      'mesh.cpp',
                      'mesh.hpp',
                      'model.cpp',
                      'model.hpp',
                      'workspace.cpp',
                      'workspace.hpp',
                      'fb_game.cpp',
                      'fb_game.hpp',
                      'instance.cpp',
                      'instance.hpp',
                      'joint.cpp',
                      'joint.hpp',
		      'runservice.cpp',
                      'runservice.hpp',
                      'script.cpp',
                      'script.hpp',
                      'script_api.cpp',
                      'script_api.hpp',
                      'script_context.cpp',
                      'script_context.hpp',
		      'service.cpp',
		      'service.hpp',
                      'pipeline.cpp',
                      'pipeline.hpp',
                      'pvinstance.cpp',
                      'pvinstance.hpp',
		      'palette.cpp',
		      'palette.hpp',
                      'players.cpp',
                      'players.hpp',
                      'player.cpp',
                      'player.hpp',
                      'soul.cpp',
                      'soul.hpp',
                      dependencies: rdm4001_dep, link_with: lua
                     )

executable('freeblock-editor',
           'editor/main.cpp',
           dependencies: rdm4001_dep, link_with: base
          )

executable('freeblock',
	   'player/main.cpp',
	   dependencies: rdm4001_dep, link_with: base
          )
